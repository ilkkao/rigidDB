{
  "name": "rigiddb",
  "version": "2.0.0",
  "description": "Object store with an index and strict schema",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "test": "mocha",
    "coverage": "c8 mocha",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilkkao/rigidDB.git"
  },
  "keywords": [
    "object",
    "store",
    "redis"
  ],
  "author": "Ilkka Oksanen <iao@iki.fi> (http://iao.fi)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ilkkao/rigidDB/issues"
  },
  "homepage": "https://github.com/ilkkao/rigidDB#readme",
  "dependencies": {
    "debug": "^4.4.3",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/debug": "^4.1.13",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "mocha": "^12.0.3",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  }
}
